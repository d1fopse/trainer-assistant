# Скопіюйте в .env і заповніть. Файл .env у git не потрапляє.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trainer
# Токен бота від @BotFather — нікому не передавайте
BOT_TOKEN=
# Ваш Telegram ID (від @userinfobot); кілька — через кому
TRAINER_TELEGRAM_IDS=
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Лише для локальної розробки в браузері без Telegram (Authorization: dev <id>)
DEV_AUTH_BYPASS=false
