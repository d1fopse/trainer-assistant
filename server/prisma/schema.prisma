generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINER
  CLIENT
  GUEST
}

enum Language {
  uk
  ru
}

enum ClientStatus {
  GUEST
  ACTIVE
  INACTIVE
}

/// Telegram-акаунт. Тренер визначається за TRAINER_TELEGRAM_IDS на сервері,
/// а не за цим полем; для тренера role завжди перевизначається в auth.
model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  role       Role     @default(GUEST)
  language   Language @default(uk)
  firstName  String?
  username   String?
  createdAt  DateTime @default(now())
  client     Client?
}

/// Картка клієнта. Існує і без Telegram-акаунта (userId порожній),
/// пізніше прив'язується до User.
model Client {
  id                 Int          @id @default(autoincrement())
  userId             Int?         @unique
  user               User?        @relation(fields: [userId], references: [id])
  name               String
  phone              String?
  status             ClientStatus @default(GUEST)
  goal               String?
  experience         String?
  health             String?
  injuries           String?
  consentAt          DateTime?
  trainerNotes       String?
  referredByClientId Int?
  referredBy         Client?      @relation("Referrals", fields: [referredByClientId], references: [id])
  referrals          Client[]     @relation("Referrals")
  createdAt          DateTime     @default(now())
}

model Setting {
  key   String @id
  value String
}
